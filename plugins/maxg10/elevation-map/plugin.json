{
    "id": "maxg10/elevation-map",
    "name": "Elevation Map",
    "version": "1.0.1",
    "description": "Terrain/elevation overlay for the map — toggle topographic tiles on/off",
    "author": {
        "name": "Mariusz Gieparda",
        "email": "mgieparda@yahoo.com",
        "url": "https://github.com/maxg10"
    },
    "license": "GPL-3.0",
    "homepage": "https://github.com/maxg10/meshplugin-elevation-map",
    "compatibility": {
        "min_mapper_version": "2.2.0",
        "tested_up_to": "2.4.0"
    },
    "permissions": [
        "raw_map_access"
    ],
    "backend": null,
    "frontend": {
        "pages": [],
        "js": "frontend/js/elevation.js",
        "css": null
    },
    "hooks": [],
    "api_routes": [],
    "websocket_channels": [],
    "dependencies": [],
    "config": {
        "tile_provider": {
            "type": "select",
            "options": ["opentopomap", "stamen_terrain", "shaded_relief"],
            "default": "opentopomap",
            "description": "Tile provider for elevation layer"
        },
        "default_enabled": {
            "type": "boolean",
            "default": false,
            "description": "Show elevation layer on startup"
        },
        "opacity": {
            "type": "number",
            "default": 70,
            "min": 10,
            "max": 100,
            "description": "Layer opacity (%)"
        }
    }
}
