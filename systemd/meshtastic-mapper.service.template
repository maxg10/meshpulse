[Unit]
Description=Meshtastic Network Mapper (Listen Mode)
After=network.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{REPO_PATH}}
ExecStart=/usr/bin/python3 -u {{REPO_PATH}}/backend/meshtastic_mapper.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
