[Unit]
Description=Meshtastic Network Mapper (Listen Mode)
After=network.target

[Service]
Type=simple
User=maxg
Group=maxg
WorkingDirectory=/home/maxg
ExecStart=/usr/bin/python3 -u /home/maxg/meshtastic_mapper.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
