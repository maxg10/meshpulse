[Unit]
Description=Meshtastic Network Mapper (Listen Mode)
After=network.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h
ExecStart=/usr/bin/python3 -u %h/meshtastic_mapper_simple.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
