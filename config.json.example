{
  "_where": "This is an EXAMPLE, not the file MeshPulse reads. The live config lives in the web root — /var/www/html/meshpulse/config.json — and a copy left next to this example is ignored silently. Copy this file there, then restart the service.",
  "connection_type": "serial",
  "port": null,
  "_port_note": "null = auto-detect the first free serial device. Prefer an explicit /dev/serial/by-id/... path: ttyUSB/ttyACM numbering shifts on reboot, and auto-detect has no way to tell one radio from another.",
  "host": null,
  "_host_note": "For TCP mode, 'host' accepts 'host' or 'host:port', e.g. \"192.168.1.100:4405\" — the port defaults to 4403 (Meshtastic standard) when omitted",
  "stats_retention_days": 30,
  "remote_admin_write": false,
  "_remote_admin_note": "true lets the map's Remote admin window change settings of nodes that list this tracker's public key as an admin key. Anyone who can open this MeshPulse page can then use it. Every write is logged in stats.db (admin_audit).",
  "_stats_retention_note": "Days of raw packet history kept in stats.db (1 to 365). The hourly traffic summary is kept regardless. 30 days of a busy mesh is roughly 30 to 90 MB."
}
